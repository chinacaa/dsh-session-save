{
  "name": "dsh-session-save",
  "version": "0.2.3",
  "description": "Save the current Session to a .dsproj file from the Session header, Word-style: first save asks where, later saves overwrite the same file. Also opens a .dsproj from disk and switches to that Session.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "dialog/",
    "screenshots.json",
    "assets/icon-180.png",
    "assets/screenshot-icons.png",
    "assets/screenshot-save-dialog.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "session",
    "session-save",
    "session-export",
    "dsproj",
    "autosave"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chinacaa/dsh-session-save.git"
  },
  "homepage": "https://github.com/chinacaa/dsh-session-save#readme",
  "bugs": {
    "url": "https://github.com/chinacaa/dsh-session-save/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
